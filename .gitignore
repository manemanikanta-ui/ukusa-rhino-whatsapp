# Secret keys — never upload
.env
.env.local

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
.venv/
venv/

# PyCharm settings
.idea/

# Audio files — too large for GitHub
*.wav

# Conversation logs — personal data
conversation_*.json

# Ngrok
start_ngrok.py

Set-Content -Encoding UTF8 .gitignore @'
.env
__pycache__/
*.pyc
data/
logs/
*.log
*.docx
*.pdf
.venv/
venv/
'@
